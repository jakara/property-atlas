{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianjin-house.local/schemas/policies.schema.json",
  "title": "Policies / 政策条款",
  "type": "object",
  "required": ["version", "count", "items"],
  "additionalProperties": true,
  "properties": {
    "version": { "$ref": "_common.schema.json#/$defs/version" },
    "count":   { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/Policy" }
    }
  },
  "$defs": {
    "Policy": {
      "type": "object",
      "required": ["id", "category", "name", "source"],
      "additionalProperties": true,
      "properties": {
        "id":          { "$ref": "_common.schema.json#/$defs/id_policy" },
        "category":    {
          "type": "string",
          "enum": ["落户", "转学", "入学", "高考", "中考", "小升初"]
        },
        "subcategory": { "type": "string" },
        "name":        { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "eligibility": { "type": "array", "items": { "type": "string" } },
        "rules":       { "type": "array", "items": { "type": "string" } },
        "docs":        { "type": "array", "items": { "type": "string" } },
        "steps":       { "type": "array", "items": { "type": "string" } },
        "caveats":     { "type": "array", "items": { "type": "string" } },
        "applicable":  { "type": "array", "items": { "type": "string" } },
        "schools":     { "type": "array", "items": { "type": "string" } },
        "specific_schools_3yr": { "type": "array", "items": { "type": "string" } },
        "rules_by_district": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timing":      { "type": "object", "additionalProperties": { "type": "string" } },
        "process":     { "type": "string" },
        "effective_date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
        "note":        { "type": "string" },
        "source":      { "type": "string", "description": "原始 pptx slide 引用" }
      }
    }
  }
}
